# Copy to .env and adjust. Used by docker-compose.yml.
# Model id served by LM Studio (see GET http://localhost:1234/v1/models).
LLM_MODEL=your-model-id

# Host ports for the containers (defaults: backend 8080, frontend 4200).
# BACKEND_PORT=8080
# FRONTEND_PORT=4200

# Override only if LM Studio is not on the host's default port 1234.
# LLM_BASE_URL=http://host.docker.internal:1234/v1
# LM_STUDIO_BASE_URL=http://host.docker.internal:1234
