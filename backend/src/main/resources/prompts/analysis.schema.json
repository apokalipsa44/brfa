{
  "type": "object",
  "properties": {
    "employer": { "type": "string" },
    "position": { "type": "string" },
    "matchScore": { "type": "integer" },
    "matchedKeywords": { "type": "array", "items": { "type": "string" } },
    "missingKeywords": { "type": "array", "items": { "type": "string" } },
    "suggestions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "section": { "type": "string" },
          "problem": { "type": "string" },
          "proposal": { "type": "string" },
          "before": { "type": "string" },
          "after": { "type": "string" },
          "priority": { "enum": ["HIGH", "MEDIUM", "LOW"] }
        },
        "required": ["section", "problem", "proposal", "before", "after", "priority"],
        "additionalProperties": false
      }
    },
    "summary": { "type": "string" }
  },
  "required": ["employer", "position", "matchScore", "matchedKeywords", "missingKeywords", "suggestions", "summary"],
  "additionalProperties": false
}